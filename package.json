{
  "name": "hypergate",
  "version": "2.0-snapshot",
  "description": "TCP and UDP gateway and reverse proxy built on top of hyperswarm",
  "main": "src/cli.ts",
  "dependencies": {
    "@hyperswarm/dht": "^6.5.1",
    "hyperswarm": "^4.17.1",
    "minimist": "^1.2.8",
    "node-docker-api": "^1.1.22"
  },
  "bin": {
    "hypergate": "./build/dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/riccardobl/hypergate.git"
  },
  "author": "Riccardo Balbo",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/riccardobl/hypergate/issues"
  },
  "homepage": "https://github.com/riccardobl/hypergate",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "overrides": {
    "minimatch": "^10.2.2",
    "sodium-native": "5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "tsc",
    "start": "node ./build/dist/cli.js",
    "debug": "HYPERGATE_VERBOSE=true tsx src/cli",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "format": "prettier --write 'src/**/*.{js,ts,tsx,jsx,json,css,scss,md}'",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
